<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (Android 12+ reads data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Field captures contain camera frames of people and places; they leave the device only when
         the user exports them (local-navigation-implementation §4). -->
    <exclude domain="file" path="captures/" />
</full-backup-content>
