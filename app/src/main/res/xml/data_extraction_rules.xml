<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- Field captures contain camera frames of people and places; they leave the device only when
         the user exports them (local-navigation-implementation §4). -->
    <cloud-backup>
        <exclude domain="file" path="captures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="captures/" />
    </device-transfer>
</data-extraction-rules>
